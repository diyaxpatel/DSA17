#include <iostream>
using namespace std;

int main()
{
    int hash[10], n, key, index;

    for(int i = 0; i < 10; i++)
        hash[i] = -1;

    cout << "Enter number of clients: ";
    cin >> n;

    for(int i = 0; i < n; i++)
    {
        cout << "Enter telephone number: ";
        cin >> key;

        index = key % 10;

        int j = 0;

        while(hash[(index + j * j) % 10] != -1 && j < 10)
            j++;

        if(j < 10)
            hash[(index + j * j) % 10] = key;
        else
            cout << "Hash table is full";
    }

    cout << "\nHash Table:\n";

    for(int i = 0; i < 10; i++)
        cout << i << " : " << hash[i] << endl;

    return 0;
}
