#include <iostream>
using namespace std;

int main()
{
    float a[100], temp;
    int n, i, j;

    cout << "Enter number of students: ";
    cin >> n;

    cout << "Enter percentages: ";
    for(i = 0; i < n; i++)
        cin >> a[i];

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(a[j] > a[j + 1])
            {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    cout << "\nSorted percentages: ";

    for(i = 0; i < n; i++)
        cout << a[i] << " ";

    cout << "\nTop five scores: ";

    for(i = n - 1; i >= 0 && i >= n - 5; i--)
        cout << a[i] << " ";

    return 0;
}
