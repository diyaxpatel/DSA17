#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *next;
};

Node *hash[10] = {NULL};

void insert(int key)
{
    int index = key % 10;

    Node *newnode = new Node;
    newnode->data = key;
    newnode->next = hash[index];

    hash[index] = newnode;
}

void display()
{
    for(int i = 0; i < 10; i++)
    {
        cout << "\n" << i << " : ";

        Node *temp = hash[i];

        while(temp != NULL)
        {
            cout << temp->data << " -> ";
            temp = temp->next;
        }

        cout << "NULL";
    }
}

int main()
{
    int n, key;

    cout << "Enter number of elements: ";
    cin >> n;

    for(int i = 0; i < n; i++)
    {
        cout << "Enter number: ";
        cin >> key;

        insert(key);
    }

    cout << "\nHash Table using Chaining:";
    display();

    return 0;
}
