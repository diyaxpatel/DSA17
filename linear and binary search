#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    int a[100], n, key, i, count = 0;
    int choice;

    cout << "Enter number of students: ";
    cin >> n;

    cout << "Enter roll numbers: ";
    for(i = 0; i < n; i++)
        cin >> a[i];

    cout << "\n1. Linear Search";
    cout << "\n2. Binary Search";
    cout << "\nEnter choice: ";
    cin >> choice;

    cout << "Enter roll number to search: ";
    cin >> key;

    if(choice == 1)
    {
        for(i = 0; i < n; i++)
        {
            count++;

            if(a[i] == key)
            {
                cout << "Student found at position " << i + 1;
                break;
            }
        }

        if(i == n)
            cout << "Student not found";

        cout << "\nComparisons: " << count;
    }
    else if(choice == 2)
    {
        sort(a, a + n);

        int low = 0, high = n - 1, mid;
        bool found = false;

        while(low <= high)
        {
            mid = (low + high) / 2;
            count++;

            if(a[mid] == key)
            {
                found = true;
                break;
            }
            else if(key > a[mid])
                low = mid + 1;
            else
                high = mid - 1;
        }

        if(found)
            cout << "Student found";
        else
            cout << "Student not found";

        cout << "\nComparisons: " << count;
    }
    else
        cout << "Invalid choice";

    return 0;
}
