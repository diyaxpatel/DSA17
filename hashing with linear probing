#include <iostream>
using namespace std;
int main()
{
    int hash[10], n, key, index;
    for(int i = 0; i < 10; i++)
        hash[i] = -1;
    cout << "Enter number of clients: ";
    cin >> n;
    if(n < 0 || n > 10)
    {
        cout << "Invalid number of clients";
        return 0;
    }
    for(int i = 0; i < n; i++)
    {
        cout << "Enter telephone number: ";
        cin >> key;
        index = key % 10;
        while(hash[index] != -1)
        {
            index = (index + 1) % 10;
        }
        hash[index] = key;
    }
    cout << "\nHash Table:\n";
    for(int i = 0; i < 10; i++)
        cout << i << " : " << hash[i] << endl;
    cout << "\nEnter number to search: ";
    cin >> key;
    index = key % 10;
    int start = index;
    while(hash[index] != -1)
    {
        if(hash[index] == key)
        {
            cout << "Number found at index " << index;
            return 0;
        }
        index = (index + 1) % 10;
        if(index == start)
            break;
    }
    cout << "Number not found";
    return 0;
}
