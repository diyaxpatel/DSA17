#include <iostream>
using namespace std;

struct Node
{
    int prn;
    string name;
    Node *next;
};

Node *head = NULL;

void addMember()
{
    Node *newnode = new Node;

    cout << "Enter PRN: ";
    cin >> newnode->prn;

    cout << "Enter Name: ";
    cin >> newnode->name;

    newnode->next = NULL;

    if(head == NULL)
        head = newnode;
    else
    {
        Node *temp = head;

        while(temp->next != NULL)
            temp = temp->next;

        temp->next = newnode;
    }

    cout << "Member added";
}

void display()
{
    Node *temp = head;

    if(head == NULL)
    {
        cout << "No members";
        return;
    }

    while(temp != NULL)
    {
        cout << "\nPRN: " << temp->prn;
        cout << " Name: " << temp->name;

        temp = temp->next;
    }
}

void countMembers()
{
    int count = 0;
    Node *temp = head;

    while(temp != NULL)
    {
        count++;
        temp = temp->next;
    }

    cout << "Total members: " << count;
}

int main()
{
    int choice;

    do
    {
        cout << "\n\n1. Add Member";
        cout << "\n2. Display Members";
        cout << "\n3. Count Members";
        cout << "\n4. Exit";

        cout << "\nEnter choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1: addMember(); break;
            case 2: display(); break;
            case 3: countMembers(); break;
            case 4: break;
            default: cout << "Invalid choice";
        }

    } while(choice != 4);

    return 0;
}
